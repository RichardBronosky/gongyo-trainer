# Copy to .env to override local development settings. Environment variables
# take precedence. Keep credentials in their tools' user-level configuration.

HTTP_BIND=127.0.0.1
HTTP_PORT=8000
# Defaults to this repository's web/ directory.
WEB_ROOT=
# The public command deliberately ignores HTTP_BIND and binds to localhost.

# Leave empty on the Free plan so ngrok selects the account's allowed endpoint.
# Set this only after reserving a custom domain on a paid plan.
NGROK_URL=

# Change NTFY_SERVER_URL when the local ntfy server is available; NTFY_TOPIC
# remains independent of the server location.
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=BrunoBronosky
